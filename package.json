{
  "name": "@yoshintame/ox-config",
  "version": "0.0.0-development",
  "description": "Shared oxlint and oxfmt presets",
  "license": "MIT",
  "author": "Mikhail Ivanov <m.ivanov0427@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshintame/ox-config.git"
  },
  "keywords": [
    "oxc",
    "oxlint",
    "oxfmt",
    "config",
    "preset"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint:package": "bun run build && publint --strict && attw --pack . --profile esm-only",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0 <1",
    "oxlint": "^1.87.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsconfig/bun": "^1.0.11",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "publint": "^0.3.12",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
